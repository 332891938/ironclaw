{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "ironclaw-client",
  "version": "0.1.0",
  "identifier": "com.xumin.tauri-client",
  "build": {
    "beforeDevCommand": "npm run dev",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "npm run build:tauri-assets",
    "frontendDist": "../dist"
  },
  "app": {
    "withGlobalTauri": true,
    "windows": [
      {
        "label": "main",
        "title": "ironclaw-client",
        "url": "https://ironclaw.axiayun.com/",
        "width": 1440,
        "height": 1000,
        "minWidth": 1200,
        "minHeight": 760
      }
    ],
    "security": {
      "csp": null,
      "capabilities": ["default"]
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "resources": [
      "resources/bin",
      "resources/channels",
      "resources/tools",
      "resources/skills"
    ],
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ]
  }
}
