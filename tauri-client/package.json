{
  "name": "tauri-client",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc && vite build",
    "build:ironclaw-bin": "bash ./scripts/build-bundled-ironclaw.sh",
    "build:ironclaw-bin:all": "IRONCLAW_BUILD_MODE=all bash ./scripts/build-bundled-ironclaw.sh",
    "build:channels": "bash ./scripts/build-bundled-channels.sh",
    "build:tools": "bash ./scripts/build-bundled-tools.sh",
    "build:skills": "bash ./scripts/build-bundled-skills.sh",
    "build:tauri-assets": "npm run build && npm run build:ironclaw-bin && npm run build:channels && npm run build:tools && npm run build:skills",
    "preview": "vite preview",
    "tauri": "tauri"
  },
  "dependencies": {
    "@tauri-apps/api": "^2",
    "@tauri-apps/plugin-opener": "^2",
    "react": "^19.2.4",
    "react-dom": "^19.2.4"
  },
  "devDependencies": {
    "@tailwindcss/postcss": "^4.2.2",
    "@tauri-apps/cli": "^2",
    "@types/react": "^19.2.14",
    "@types/react-dom": "^19.2.3",
    "@vitejs/plugin-react": "^5.0.0",
    "postcss": "^8.5.8",
    "tailwindcss": "^4.2.2",
    "typescript": "~5.6.2",
    "vite": "^6.0.3"
  }
}
